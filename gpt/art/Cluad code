// SILKFRONT — ground painting for the baked terrain layer (half resolution, painted once per match).
// Replaces the flat per-tile tint with large-scale ground variation (dead grass / ash / earth / moss), pixel grain,
// a worn road with ruts, and — when the scenery spec asks for it — a shallow stream with a gravel ford.
import { TILE, MAP_W, MAP_H } from './data.js';
import { fbm, vnoise, rng } from './sprites.js';
import { riverLine } from './decor.js';

const PALETTES = {
  ash: { A: [56, 57, 43], B: [96, 93, 84], C: [80, 63, 45], D: [34, 41, 32], ash: 0.95, earth: 0.8 },
  pass: { A: [40, 54, 34], B: [68, 80, 54], C: [72, 59, 40], D: [27, 40, 28], ash: 0.25, earth: 0.7 },
};
const mix = (a, b, t) => [a[0] + (b[0] - a[0]) * t, a[1] + (b[1] - a[1]) * t, a[2] + (b[2] - a[2]) * t];
const sm = (a, b, x) => { const t = Math.max(0, Math.min(1, (x - a) / (b - a))); return t * t * (3 - 2 * t); };

export function roadPoints(world) { // tile units
  if (world.meta?.road) return world.meta.road;
  const m = [...world.buildings].map((b) => [b.x / TILE, b.y / TILE]); if (m.length < 2) return [];
  const [a, b] = [m[0], m[m.length - 1]], W = MAP_W, H = MAP_H, pts = []; // same bezier the previous renderer drew
  const c1 = [W * 0.3, H * 0.75], c2 = [W * 0.7, H * 0.25];
  for (let i = 0; i <= 28; i++) { const t = i / 28, u = 1 - t; pts.push([u * u * u * a[0] + 3 * u * u * t * c1[0] + 3 * u * t * t * c2[0] + t * t * t * b[0], u * u * u * a[1] + 3 * u * u * t * c1[1] + 3 * u * t * t * c2[1] + t * t * t * b[1]]); }
  return pts;
}
function along(pts, step) { // resample a polyline every `step` tiles → [{x,y,tx,ty}]
  const out = []; let carry = 0;
  for (let i = 1; i < pts.length; i++) { const [x0, y0] = pts[i - 1], [x1, y1] = pts[i], L = Math.hypot(x1 - x0, y1 - y0), dx = (x1 - x0) / (L || 1), dy = (y1 - y0) / (L || 1);
    for (let d = carry; d < L; d += step) out.push({ x: x0 + dx * d, y: y0 + dy * d, tx: dx, ty: dy }); carry = (carry + Math.ceil((L - carry) / step) * step) - L; }
  return out;
}

export function paintTerrain(world, spec, doc = document, k = 0.5) {
  const pal = PALETTES[spec?.palette] || PALETTES.pass, cw = Math.round(world.pw * k), ch = Math.round(world.ph * k), t = TILE * k;
  const cv = doc.createElement('canvas'); cv.width = cw; cv.height = ch; const g = cv.getContext('2d');
  // 1) large-scale colour field computed at 1/4 resolution then smoothly upscaled
  const lw = Math.ceil(cw / 4), lh = Math.ceil(ch / 4), low = doc.createElement('canvas'); low.width = lw; low.height = lh;
  const lg = low.getContext('2d'), im = lg.createImageData(lw, lh), d = im.data;
  for (let y = 0; y < lh; y++) for (let x = 0; x < lw; x++) {
    const wx = (x * 4) / k, wy = (y * 4) / k, n1 = fbm(wx / 520, wy / 520, 11, 3), n2 = fbm(wx / 170, wy / 170, 23, 3), n3 = fbm(wx / 70, wy / 70, 37, 3), n4 = fbm(wx / 300, wy / 300, 53, 2);
    let c = mix(pal.A, pal.D, sm(0.45, 0.7, n2)); c = mix(c, pal.C, sm(0.56, 0.78, n4) * pal.earth * 0.8); c = mix(c, pal.B, sm(0.5, 0.78, n1) * pal.ash);
    const v = 0.88 + n3 * 0.26, i = (y * lw + x) * 4; d[i] = c[0] * v; d[i + 1] = c[1] * v; d[i + 2] = c[2] * v; d[i + 3] = 255;
  }
  lg.putImageData(im, 0, 0); g.imageSmoothingEnabled = true; g.imageSmoothingQuality = 'high'; g.drawImage(low, 0, 0, cw, ch);
  // 2) soft darker/lighter blotches (mud, shade)
  const R = rng(((spec?.seed || 1) >>> 0) ^ 0x51ed27);
  for (let i = 0; i < 520; i++) {
    const x = R() * cw, y = R() * ch, r = 14 + R() * 46, dark = R() < 0.6, gr = g.createRadialGradient(x, y, 0, x, y, r);
    gr.addColorStop(0, dark ? 'rgba(14,16,12,0.26)' : 'rgba(150,146,126,0.12)'); gr.addColorStop(1, 'rgba(0,0,0,0)'); g.fillStyle = gr; g.fillRect(x - r, y - r, r * 2, r * 2);
  }
  // 3) river and road (the road is painted over the water at the ford)
  const water = spec?.river ? riverLine(spec.river) : null;
  if (water) paintRiver(g, water, spec.river, t, R);
  paintRoad(g, roadPoints(world), t, R);
  if (water && spec.river.ford) paintFord(g, spec.river, world, t, R);
  // 4) pixel grain
  const gi = g.getImageData(0, 0, cw, ch), gd = gi.data;
  for (let y = 0; y < ch; y++) for (let x = 0; x < cw; x++) {
    const i = (y * cw + x) * 4, n = (vnoise(x / 2.5, y / 2.5, 5) - 0.5) * 16 + (vnoise(x * 1.7, y * 1.7, 9) - 0.5) * 12;
    gd[i] += n; gd[i + 1] += n * 0.95; gd[i + 2] += n * 0.8;
  }
  g.putImageData(gi, 0, 0);
  // 5) map edge falloff
  for (const [x0, y0, x1, y1, w, h] of [[0, 0, 0, 1, cw, 3 * t], [0, ch, 0, -1, cw, 3 * t], [0, 0, 1, 0, 3 * t, ch], [cw, 0, -1, 0, 3 * t, ch]]) {
    const gr = g.createLinearGradient(x0, y0, x0 + x1 * 3 * t, y0 + y1 * 3 * t); gr.addColorStop(0, 'rgba(3,4,6,0.55)'); gr.addColorStop(1, 'rgba(3,4,6,0)'); g.fillStyle = gr;
    g.fillRect(x1 < 0 ? x0 - w : x0, y1 < 0 ? y0 - h : y0, w, h);
  }
