// AudioManager contract with fake Web Audio / fetch / storage: no sound before a gesture, silent failure for missing
// assets, crossfade on context change, playlists, persisted volumes, mute/duck.
import test from 'node:test';
import assert from 'node:assert/strict';
import { AudioManager } from '../src/audio.js';

class Param { constructor() { this.value = 1; } setTargetAtTime(v) { this.value = v; } }
const node = () => ({ gain: new Param(), connect() {}, disconnect() {} });
function rig({ files = {}, manifest } = {}) {
  const log = { sources: [], fetched: [], timers: [] };
  class AC {
    constructor() { this.state = 'suspended'; this.currentTime = 0; this.destination = {}; log.ctx = this; }
    resume() { this.state = 'running'; return Promise.resolve(); }
    createGain() { return node(); }
    createBufferSource() { const s = { loop: false, started: false, stopped: false, connect() {}, start() { this.started = true; }, stop() { this.stopped = true; } }; log.sources.push(s); return s; }
    decodeAudioData(ab) { return Promise.resolve({ duration: ab.byteLength }); }
  }
  const fetchFn = async (url) => { log.fetched.push(url);
    if (url.endsWith('manifest.json')) return manifest ? { ok: true, json: async () => manifest } : { ok: false, status: 404 };
    return files[url] ? { ok: true, arrayBuffer: async () => new ArrayBuffer(files[url]) } : { ok: false, status: 404 }; };
  const mem = {}, storage = { getItem: (k) => mem[k] ?? null, setItem: (k, v) => { mem[k] = v; } };
  const am = new AudioManager({ fetchFn, AC, storage, timers: { set: (f, ms) => log.timers.push([f, ms]) } });
  return { am, log, mem, storage };
}
